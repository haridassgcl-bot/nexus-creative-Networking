generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ENGINEER
  ADMIN
}

enum EngineerStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum Availability {
  ONLINE
  BUSY
  OFFLINE
}

enum ServiceMode {
  REMOTE
  ONSITE
  BOTH
}

enum JobStatus {
  REQUESTED
  MATCHING
  OFFERED
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  REPORT_SUBMITTED
  CUSTOMER_APPROVAL
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OfferStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum SettlementStatus {
  PENDING
  ELIGIBLE
  PAID
  ON_HOLD
}

model User {
  id           String           @id @default(cuid())
  name         String
  phone        String           @unique
  email        String?          @unique
  passwordHash String?
  role         UserRole
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  customer     CustomerProfile?
  engineer     EngineerProfile?
  jobs         Job[]            @relation("CustomerJobs")
  auditLogs    AuditLog[]
}

model CustomerProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  companyName    String?
  gstin          String?
  defaultAddress String?
  latitude       Float?
  longitude      Float?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EngineerProfile {
  id              String             @id @default(cuid())
  userId          String             @unique
  bio             String?
  city            String
  serviceRadiusKm Int                @default(10)
  latitude        Float?
  longitude       Float?
  status          EngineerStatus     @default(PENDING)
  availability    Availability       @default(OFFLINE)
  experienceYears Int                @default(0)
  rating          Float              @default(5)
  completedJobs   Int                @default(0)
  baseVisitFee    Int                @default(0)
  verifiedAt      DateTime?
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          EngineerSkill[]
  locations       EngineerLocation[]
  offers          JobOffer[]
  assignments     JobAssignment[]
}

model Skill {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  category       String
  engineerSkills EngineerSkill[]
  serviceSkills  ServiceSkill[]
}

model EngineerSkill {
  id              String          @id @default(cuid())
  engineerId      String
  skillId         String
  proficiency     Int             @default(3)
  verified        Boolean         @default(false)
  yearsExperience Int             @default(0)
  engineer        EngineerProfile @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  skill           Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([engineerId, skillId])
}

model ServiceCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  services Service[]
}

model Service {
  id               String          @id @default(cuid())
  categoryId       String
  title            String
  description      String
  mode             ServiceMode     @default(BOTH)
  basePrice        Int
  estimatedMinutes Int             @default(60)
  active           Boolean         @default(true)
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  requiredSkills   ServiceSkill[]
  jobItems         JobItem[]
}

model ServiceSkill {
  id                 String  @id @default(cuid())
  serviceId          String
  skillId            String
  minimumProficiency Int     @default(2)
  required           Boolean @default(true)
  service            Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  skill              Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([serviceId, skillId])
}

model Job {
  id                   String           @id @default(cuid())
  customerId           String
  status               JobStatus        @default(REQUESTED)
  mode                 ServiceMode
  address              String?
  latitude             Float
  longitude            Float
  requestedAt          DateTime         @default(now())
  scheduledAt          DateTime?
  customerNotes        String?
  quotedTotal          Int
  currency             String           @default("INR")
  searchRadiusKm       Int              @default(10)
  currentDispatchRound Int              @default(0)
  customer             User             @relation("CustomerJobs", fields: [customerId], references: [id])
  items                JobItem[]
  offers               JobOffer[]
  assignment           JobAssignment?
  payment              Payment?
  events               JobEvent[]
  report               TechnicalReport?

  @@index([status, requestedAt])
}

model JobItem {
  id                String  @id @default(cuid())
  jobId             String
  serviceId         String
  titleSnapshot     String
  unitPriceSnapshot Int
  quantity          Int     @default(1)
  job               Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service           Service @relation(fields: [serviceId], references: [id])
}

model JobOffer {
  id          String          @id @default(cuid())
  jobId       String
  engineerId  String
  status      OfferStatus     @default(SENT)
  matchScore  Float
  distanceKm  Float
  sentAt      DateTime        @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  engineer    EngineerProfile @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([jobId, engineerId])
  @@index([engineerId, status, expiresAt])
}

model JobAssignment {
  id          String          @id @default(cuid())
  jobId       String          @unique
  engineerId  String
  acceptedAt  DateTime        @default(now())
  completedAt DateTime?
  job         Job             @relation(fields: [jobId], references: [id])
  engineer    EngineerProfile @relation(fields: [engineerId], references: [id])
}

model EngineerLocation {
  id             String          @id @default(cuid())
  engineerId     String
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  recordedAt     DateTime        @default(now())
  engineer       EngineerProfile @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId, recordedAt])
}

model JobEvent {
  id        String    @id @default(cuid())
  jobId     String
  status    JobStatus
  note      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model TechnicalReport {
  id                  String    @id @default(cuid())
  jobId               String    @unique
  summary             String
  workPerformed       String
  verificationResults String?
  attachmentUrls      String[]
  customerApprovedAt  DateTime?
  createdAt           DateTime  @default(now())
  job                 Job       @relation(fields: [jobId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  jobId             String        @unique
  provider          String
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amount            Int
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  job               Job           @relation(fields: [jobId], references: [id])
  commission        Commission?
}

model Commission {
  id               String           @id @default(cuid())
  paymentId        String           @unique
  grossAmount      Int
  commissionRate   Float
  commissionAmount Int
  engineerAmount   Int
  settlementStatus SettlementStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  payment          Payment          @relation(fields: [paymentId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
}
